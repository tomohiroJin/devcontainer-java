{
  "name": "Java 25 / Gradle",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "LANG": "ja_JP.UTF-8",
    "TZ": "Asia/Tokyo"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "EditorConfig.EditorConfig"
      ]
    }
  },
  "mounts": [
    "source=devcontainer-java-gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.gradle && ./gradlew --version"
}
