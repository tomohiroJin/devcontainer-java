    "usernamehw",
    "vscode",
    "vscjava",
    "vsliveshare",
    "wmaurer",
    "yzhang",
    "zoneinfo"
  ],
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-25",
      "path": "/home/vscode/.sdkman/candidates/java/current"
    }
  ],
  "java.home": "/home/vscode/.sdkman/candidates/java/current",
  // Java formatting and code organization
  "java.format.settings.url": null,
  "java.format.settings.profile": null,
  "java.saveActions.organizeImports": true,
  // Gradle settings
  "java.import.gradle.home": "/home/vscode/.sdkman/candidates/gradle/current",
  "java.import.gradle.java.home": "/home/vscode/.sdkman/candidates/java/current",
  // build.gradle の変更を検知したら確認なしでプロジェクトを再インポートする
  // (既定の interactive では通知を見逃すとクラスパスが古いまま残る)
  "java.configuration.updateBuildConfiguration": "automatic",
  // Editor: 保存時に整形とインポート整理を行う
  "editor.formatOnSave": true,
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  // ファイル整形の共通ルール（OS 差分による差分ノイズを防ぐ）
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  // Live Share でペアプロ中に見やすくする
  "editor.rulers": [
    100
  ],
  "todo-tree.general.tags": [
    "TODO",
    "FIXME",
    "NOTE",
    "HACK"
  ]
}
